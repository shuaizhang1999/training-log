# Copy to .env.local for local dev; set the same four in Vercel for production.

# Service account that has been shared on the spreadsheet (Editor).
# Looks like: training-log@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The "private_key" value from the service account's JSON key file.
# Paste it as-is, including -----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----
# Both real newlines and the JSON file's literal \n sequences work.
GOOGLE_PRIVATE_KEY=

# The spreadsheet being logged to (already filled in — it's not a secret by itself).
SHEET_ID=1woDU57iY2WQCdWbnFihPlKrCTYoHIPdQs2mOBfvubvc

# The single shared password for the app. Pick something long; you type it once
# per device, then a year-long cookie keeps you signed in.
APP_PASSWORD=
